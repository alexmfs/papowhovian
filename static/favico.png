<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ULTIMA7</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #0a0a0a;
    color: #00ff41;
    font-family: 'JetBrains Mono', monospace;
    min-height: 100vh;
    overflow: hidden;
    position: relative;
  }

  /* Matrix rain canvas */
  #matrix {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.06;
  }

  /* Scanline effect */
  .scanline {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 1px,
      rgba(0, 255, 65, 0.015) 1px,
      rgba(0, 255, 65, 0.015) 2px
    );
  }

  /* CRT flicker */
  .crt {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    animation: flicker 0.15s infinite;
  }

  @keyframes flicker {
    0% { opacity: 0.97; }
    50% { opacity: 1; }
    100% { opacity: 0.98; }
  }

  /* Main content */
  .container {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .terminal {
    width: 100%;
    max-width: 720px;
    background: rgba(10, 10, 10, 0.85);
    border: 1px solid rgba(0, 255, 65, 0.15);
    border-radius: 4px;
    padding: 2rem 2.5rem;
    box-shadow:
      0 0 40px rgba(0, 255, 65, 0.03),
      inset 0 0 60px rgba(0, 0, 0, 0.3);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(0, 255, 65, 0.1);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(0, 255, 65, 0.3);
  }
  .dot:first-child { background: #ff5f57; opacity: 0.7; }
  .dot:nth-child(2) { background: #ffbd2e; opacity: 0.7; }
  .dot:nth-child(3) { background: #28c840; opacity: 0.7; }

  .terminal-title {
    margin-left: 12px;
    font-size: 0.7rem;
    color: rgba(0, 255, 65, 0.3);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .line {
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.7;
    opacity: 0;
    animation: typeLine 0.3s ease forwards;
  }

  .line .prompt {
    color: #00ff41;
    opacity: 0.5;
  }

  .line .cmd {
    color: #00ff41;
  }

  .line .comment {
    color: rgba(0, 255, 65, 0.2);
    font-style: italic;
  }

  .line .output {
    color: rgba(0, 255, 65, 0.6);
  }

  .line .highlight {
    color: #fff;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
  }

  .line .warn {
    color: #ffbd2e;
    opacity: 0.8;
  }

  .line .dim {
    color: rgba(0, 255, 65, 0.15);
  }

  /* Logo */
  .logo {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 12px;
    color: #fff;
    text-shadow:
      0 0 20px rgba(0, 255, 65, 0.4),
      0 0 40px rgba(0, 255, 65, 0.2);
    margin-bottom: 0.3rem;
    text-transform: uppercase;
  }

  .tagline {
    font-size: 0.75rem;
    letter-spacing: 6px;
    color: rgba(0, 255, 65, 0.25);
    margin-bottom: 2rem;
    text-transform: uppercase;
  }

  /* Cursor blink */
  .cursor {
    display: inline-block;
    width: 8px;
    height: 15px;
    background: #00ff41;
    margin-left: 2px;
    animation: blink 1s step-end infinite;
    vertical-align: text-bottom;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @keyframes typeLine {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Animation delays for lines */
  .line:nth-child(1) { animation-delay: 0.5s; }
  .line:nth-child(2) { animation-delay: 1.0s; }
  .line:nth-child(3) { animation-delay: 1.5s; }
  .line:nth-child(4) { animation-delay: 2.0s; }
  .line:nth-child(5) { animation-delay: 2.5s; }
  .line:nth-child(6) { animation-delay: 3.0s; }
  .line:nth-child(7) { animation-delay: 3.5s; }
  .line:nth-child(8) { animation-delay: 4.0s; }
  .line:nth-child(9) { animation-delay: 4.5s; }
  .line:nth-child(10) { animation-delay: 5.0s; }
  .line:nth-child(11) { animation-delay: 5.5s; }
  .line:nth-child(12) { animation-delay: 6.0s; }
  .line:nth-child(13) { animation-delay: 6.5s; }
  .line:nth-child(14) { animation-delay: 7.0s; }

  /* Progress bar */
  .progress-bar {
    display: inline-block;
    width: 200px;
    height: 2px;
    background: rgba(0, 255, 65, 0.1);
    position: relative;
    vertical-align: middle;
    margin: 0 8px;
  }
  .progress-bar::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background: #00ff41;
    animation: loading 3s ease forwards;
    animation-delay: 7.5s;
  }
  @keyframes loading {
    0% { width: 0%; }
    100% { width: 73%; }
  }

  /* Hidden message - only visible on hover/selection */
  .hidden-msg {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.6rem;
    letter-spacing: 4px;
    color: rgba(0, 255, 65, 0.04);
    z-index: 3;
    transition: color 0.8s ease;
    cursor: default;
    user-select: all;
    text-align: center;
    white-space: nowrap;
  }
  .hidden-msg:hover {
    color: rgba(0, 255, 65, 0.2);
  }

  /* Glitch effect on logo */
  .glitch {
    position: relative;
  }
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .glitch::before {
    animation: glitch-1 2.5s infinite;
    color: #ff00ff;
    z-index: -1;
    opacity: 0.15;
  }
  .glitch::after {
    animation: glitch-2 2.5s infinite;
    color: #00ffff;
    z-index: -1;
    opacity: 0.15;
  }

  @keyframes glitch-1 {
    0%, 100% { clip-path: inset(0 0 95% 0); transform: translate(0); }
    20% { clip-path: inset(20% 0 60% 0); transform: translate(-2px, 1px); }
    40% { clip-path: inset(60% 0 10% 0); transform: translate(2px, -1px); }
    60% { clip-path: inset(40% 0 40% 0); transform: translate(-1px, 2px); }
    80% { clip-path: inset(80% 0 5% 0); transform: translate(1px, -2px); }
  }

  @keyframes glitch-2 {
    0%, 100% { clip-path: inset(95% 0 0 0); transform: translate(0); }
    20% { clip-path: inset(60% 0 20% 0); transform: translate(2px, -1px); }
    40% { clip-path: inset(10% 0 60% 0); transform: translate(-2px, 1px); }
    60% { clip-path: inset(40% 0 30% 0); transform: translate(1px, -2px); }
    80% { clip-path: inset(5% 0 80% 0); transform: translate(-1px, 2px); }
  }

  /* Responsive */
  @media (max-width: 600px) {
    .terminal { padding: 1.5rem; }
    .logo { font-size: 1.2rem; letter-spacing: 8px; }
    .line { font-size: 0.75rem; }
    .hidden-msg { font-size: 0.5rem; letter-spacing: 2px; }
  }
</style>
</head>
<body>

<canvas id="matrix"></canvas>
<div class="scanline"></div>
<div class="crt"></div>

<div class="container">
  <div class="terminal">
    <div class="terminal-header">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="terminal-title">ultima7@core ~ /sys/rebuild</span>
    </div>

    <div class="line"><span class="prompt">$ </span><span class="cmd">whoami</span></div>
    <div class="line"><span class="output">ULTIMA7</span></div>
    <div class="line"><span class="comment"># something is happening...</span></div>
    <div class="line"><span class="prompt">$ </span><span class="cmd">cat /var/log/status.log</span></div>
    <div class="line"><span class="output">[<span class="warn">REBUILD</span>] core systems are being rewritten</span></div>
    <div class="line"><span class="output">[<span class="warn">RELOAD</span>] infrastructure upgrade in progress</span></div>
    <div class="line"><span class="dim">---</span></div>
    <div class="line"><span class="prompt">$ </span><span class="cmd">echo $MESSAGE</span></div>
    <div class="line">
      <span class="logo glitch" data-text="ULTIMA7">ULTIMA7</span>
    </div>
    <div class="line">
      <span class="highlight">we'll be back soon</span><span class="cursor"></span>
    </div>
    <div class="line"><span class="dim">---</span></div>
    <div class="line"><span class="prompt">$ </span><span class="cmd">./rebuild --progress</span></div>
    <div class="line">
      <span class="output">[##########<span class="dim">.........</span>]</span>
      <span class="output"> 73%</span>
      <span class="comment"> // not just maintenance. a new beginning.</span>
    </div>
  </div>
</div>

<div class="hidden-msg">every system needs a reboot to evolve // ultima7.dev</div>

<script>
// Matrix rain
const canvas = document.getElementById('matrix');
const ctx = canvas.getContext('2d');

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

const chars = 'ULTIMA7アウルティマ01001110101001システム再構築リロード'.split('');
const fontSize = 14;
const columns = Math.floor(canvas.width / fontSize);
const drops = Array(columns).fill(1);

function drawMatrix() {
  ctx.fillStyle = 'rgba(10, 10, 10, 0.05)';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.fillStyle = '#00ff41';
  ctx.font = fontSize + 'px monospace';

  for (let i = 0; i < drops.length; i++) {
    const char = chars[Math.floor(Math.random() * chars.length)];
    ctx.fillText(char, i * fontSize, drops[i] * fontSize);
    if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
      drops[i] = 0;
    }
    drops[i]++;
  }
}

setInterval(drawMatrix, 50);

window.addEventListener('resize', () => {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
});
</script>

<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v4513226cdae34746b4dedf0b4dfa099e1781791509496" integrity="sha512-ZE9pZaUXND66v380QUtch/5sE9tPFh2zg45pR2PB0CVkCtOREv2AJKkSidISWkysEuQ0EH8faUU5du78bx87UQ==" data-cf-beacon='{"version":"2024.11.0","token":"e1628e8002cb48ee81e6efe5cfec428d","r":1}' crossorigin="anonymous"></script>
</body>
</html>
